# .env.example
TZ=Europe/Tallinn
HA_URL=http://your-ha.local:8123
HA_TOKEN=your_long_token_here
SENSOR_SOURCE=sensor.qw_source
SENSOR_MODE=sensor.qw_mode
SENSOR_POWERLIMIT=sensor.qw_powerlimit
SENSOR_GRID_POWER=sensor.shellyem3_485519dbeee9_channel_a_power,sensor.shellyem3_485519dbeee9_channel_b_power,sensor.shellyem3_485519dbeee9_channel_c_power
SENSOR_NORDPOOL=sensor.nordpool_kwh_ee_eur_3_10_0
KRATT_SHARE=0.20
AFRR_PRICE_UP_EUR_MWH=440
AFRR_PRICE_DOWN_EUR_MWH=-530
# Optional fee defaults (cents/kWh excl. VAT; editable in the UI)
# FEE_MARGIN=0
# FEE_ELEKTRILEVI_DAY=6.07
# FEE_ELEKTRILEVI_NIGHT=3.51
# FEE_VAT=24
# Optional: aFRR market price (PICASSO CBMP) from the ENTSO-E Transparency Platform, shown for comparison
# ENTSOE_TOKEN=your_entsoe_api_token
